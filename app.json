{
  "expo": {
    "name": "Lion",
    "slug": "noirwealth",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "lion",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lion.app",
      "merchantIdentifier": "merchant.com.lion.app"
    },
    "android": {
      "package": "com.lion.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#F4EDFF"
      },
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#F4EDFF"
      },
      "navigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#F4EDFF",
        "buttonColor": "#8A2BE2"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "com.android.alarm.permission.SET_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4EDFF"
        }
      ],
      "expo-web-browser",
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#8A2BE2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85ab4a9a-6dca-4f10-87bc-c31e4727e356"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": ""
    }
  }
}